# impeccable live-mode session artifacts (regenerated per session)
.impeccable-engine/
.impeccable/live/server.json
.impeccable/live/inject-journal.json
.impeccable/live/roots.json
.impeccable/live/sessions/
.impeccable/live/annotations/
.impeccable/live/*.log

# tooling caches
.playwright-mcp/

# Ignore a stray root-level copy of the proxy. The canonical one is
# scripts/liveproxy.py and IS tracked; setup.sh runs it from there.
/liveproxy.py
