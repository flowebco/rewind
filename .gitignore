# impeccable live-mode session artifacts (regenerated per session)
.impeccable-engine/
.impeccable/live/server.json
.impeccable/live/inject-journal.json
.impeccable/live/roots.json
.impeccable/live/sessions/
.impeccable/live/annotations/
.impeccable/live/*.log

# tooling caches
.playwright-mcp/

# sandbox-only reverse proxy that makes impeccable live mode work over an
# HTTPS devtunnels origin (rewrites live.js hardcoded localhost URLs in flight).
# Not part of the product; the running copy lives at /tmp/liveproxy.py.
liveproxy.py
